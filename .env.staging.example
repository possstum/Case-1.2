APP_NAME=NETvRF
APP_ENV=staging
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false
API_PREFIX=
APP_LOG_LEVEL=INFO
CORRELATION_ID_HEADER=X-Correlation-ID

DATABASE_URL=postgresql+psycopg://netvrf:netvrf@localhost:5432/netvrf
SQL_ECHO=false

REDIS_URL=redis://localhost:6379/0
RQ_DEFAULT_QUEUE=default
HEALTH_REQUIRE_REDIS=true

MATCH_CANDIDATE_THRESHOLD=0.35
MATCH_AMBIGUOUS_THRESHOLD=0.60
MATCH_AUTO_THRESHOLD=0.88
MATCH_GAP_THRESHOLD=0.05

SEARCH_DEFAULT_LIMIT=5
SEARCH_MAX_LIMIT=10
SEARCH_CACHE_STALE_SECONDS=300
SEARCH_CACHE_TTL_SECONDS=1800
SEARCH_PROVIDER_TIMEOUT_SECONDS=5
PROVIDER_HTTP_TIMEOUT_SECONDS=5
SEARCH_PROVIDER_MAX_ATTEMPTS=1
SEARCH_PROVIDER_RETRY_BACKOFF_SECONDS=0
SYNC_PROVIDER_MAX_ATTEMPTS=1
SYNC_PROVIDER_TIMEOUT_SECONDS=5
SYNC_PROVIDER_RETRY_BACKOFF_SECONDS=0
SEARCH_RATE_LIMIT=30
SEARCH_RATE_WINDOW_SECONDS=60
SYNC_RATE_LIMIT=5
SYNC_RATE_WINDOW_SECONDS=60

YOUTUBE_MUSIC_TOKEN=
YANDEX_MUSIC_TOKEN=
